# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.pnpm-store/
.devserver.*.log
/outputs/
/work/

# OpenAI Sites hosting config (not used by the GitHub Pages deployment)
/.openai/

# Uncompressed source recordings. The compressed copies that the site actually
# serves live in public/demos/ and are ~half the size.
/Demo_AI_agent_*.mp4

# Source images kept locally; the web-optimised copies live in public/
/정승한 증명사진*.jpg
/HYU_logo_singlecolor_png.png
